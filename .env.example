PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ai-mystery-room
CLIENT_URL=http://localhost:5173
JWT_SECRET=super_secret_jwt_key_change_in_production
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Email OTP Service Configuration (Optional)
# If left unset, OTP codes are logged to the terminal & UI in Development Mode.
# To send real emails to your Gmail inbox:
# 1. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Create an App Password for "AI Mystery Room"
# 3. Fill in the values below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM="AI Mystery Room <your_email@gmail.com>"


{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/v1/:match*",
      "destination": "https://ai-mystery-room-api-jwxe.onrender.com/api/v1/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
